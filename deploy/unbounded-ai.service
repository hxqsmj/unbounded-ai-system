[Unit]
Description=无界AI超级员工系统 - FastAPI 后端
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/unbounded-ai
Environment=PATH=/opt/unbounded-ai/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/unbounded-ai/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
