# ═══════════════════════════════════════════════════════════════
# 无界AI超级员工系统 — 环境变量配置 (V4.0 生产级)
# ═══════════════════════════════════════════════════════════════
# 使用方式: cp .env.example .env 然后编辑 .env
# ⚠ 安全警告: .env 包含敏感信息，已在 .gitignore 中，切勿提交到 Git！

# ── 应用基础 ──────────────────────────────────────────────
APP_NAME=无界AI超级员工系统
APP_VERSION=4.0.0
DEBUG=false                      # 生产环境必须为 false！

# ── MongoDB (全链路 Trace 日志) ───────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=unbounded_ai
MONGO_TRACE_COLLECTION=trace_logs

# ── PostgreSQL (RAG 反馈数据飞轮) ─────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=geop                     # ⚠ 生产务必修改默认用户名/密码
PG_PASSWORD=geop_password        # ⚠ 生产务必修改默认用户名/密码
PG_DB=unbounded_ai

# ── Redis (拟人化延迟队列，留空=仅内存模式) ──────────────
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=typing_delay_queue

# ── Qdrant (向量数据库) ──────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sales_knowledge_base
QDRANT_TOP_K=3
QDRANT_SCORE_THRESHOLD=0.65    # RAG 拒答防幻觉阈值

# ── 大模型 API ───────────────────────────────────────────
# LLM 对话模型配置 (如 DeepSeek)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-llm-key-here      # ⚠ 必填：DeepSeek API Key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Embedding 向量模型配置 (独立于 LLM，如 SiliconFlow / BGE-M3)
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-embedding-key-here  # ⚠ 必填：SiliconFlow API Key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# ── 风控与防封参数 ───────────────────────────────────────
SLEEP_START_HOUR=23             # 夜间休眠开始 (23:00)
SLEEP_END_HOUR=7                # 夜间休眠结束 (07:00)
TYPING_SPEED_MIN=0.2            # 每字最低打字秒数
TYPING_SPEED_MAX=0.4            # 每字最高打字秒数
THINKING_TIME_MIN=3.0           # 最低思考时间 (秒)
THINKING_TIME_MAX=8.0           # 最高思考时间 (秒)

# ── 兜底拒答词 ────────────────────────────────────────────
FALLBACK_REPLY=已为您记录，稍后将由专人客服为您处理。

# ── WSS 网关 (本地 WebSocket) ────────────────────────────
WSS_HOST=127.0.0.1
WSS_PORT=8765
WSS_HEARTBEAT_INTERVAL=30
WSS_MAX_MISSED_PONGS=3

# ── API 服务器 ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
